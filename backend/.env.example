# ============ SERVER ============
ENV=development
PORT=8080
# Origin của frontend Vite dev server. Production đổi sang domain thật.
CORS_ORIGIN=http://localhost:5173

# ============ DATABASE (Supabase PostgreSQL) ============
# Connection string lấy ở Supabase Dashboard > Settings > Database
# Session Pooler (IPv4) — khuyến nghị cho môi trường dev/deploy không có IPv6:
# DATABASE_URL=postgresql://postgres.[PROJECT-ID]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:5432/postgres
# Direct connection:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres
# Giới hạn pool pgx. Supabase free tier chỉ cho ~60 connection tổng, chia cho
# cả cronjob và các service khác — đừng để MAX quá cao.
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# ============ REDIS ============
# Bắt buộc: dùng cho rate limit và cache catalog shop.
# Local: chạy `docker compose up redis` trong infra/ rồi dùng URL dưới đây.
REDIS_URL=redis://localhost:6379/0

# ============ SUPABASE (verify JWT qua JWKS) ============
SUPABASE_URL=https://your-project.supabase.co
